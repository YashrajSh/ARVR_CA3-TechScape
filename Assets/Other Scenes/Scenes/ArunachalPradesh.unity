  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "A thangka, also known as tangka, thanka or tanka is a painting on cloth.
    The literal translation of the Tibetan word THANG KA means \u2018recorded message\u2019.
    Among all the art and crafts in Tawang, painting occupies a very special position.
    Not only it is essential for designing, decorating and finishing many mundane
    objects, but it is also a highly developed and important means of religious expression.
    It is a medium through which the Buddhist philosophy can be explained. Thanka
    paintings have a powerful and forceful impact on most people when they first
    encounter it."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 37a1986b4660442c295a534dc348a9c8, type: 2}
  m_sharedMaterial: {fileID: 8528375497077536208, guid: 37a1986b4660442c295a534dc348a9c8, type: 2}
